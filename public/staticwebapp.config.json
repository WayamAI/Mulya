{
  "routes": [
    { "route": "/images/*", "headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=2592000" } },
    { "route": "/brand/*", "headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=2592000" } },
    { "route": "/models/*", "headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=2592000" } },
    { "route": "/_next/static/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "mimeTypes": {
    ".glb": "model/gltf-binary",
    ".gltf": "model/gltf+json",
    ".stl": "model/stl",
    ".step": "application/step",
    ".stp": "application/step"
  }
}
